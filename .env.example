# TINDAK — environment template
# Copy to .env and fill in. .env is git-ignored and must never be committed.
# The Flutter app does NOT read this file. It reads mobile/.env.client, which
# holds only public client values (mobile/README.md).

# ---------- Flutter client (safe to ship) ----------
# The anon key is a public, RLS-scoped key. It is NOT a secret, but it is still
# kept out of the repo so each environment can differ.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ---------- Server side only — Supabase Edge Function secrets ----------
# NEVER put these in the Flutter client or in any file under mobile/.
# Set them with: supabase secrets set KEY=value
# GEMINI_API_KEY=
# URL_REPUTATION_API_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
