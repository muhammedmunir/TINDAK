<?xml version="1.0" encoding="utf-8"?>
<!--
  TINDAK holds the user's saved memories on the device. Guest data has no cloud
  copy at all, so it must not be exported off the device by backup or transfer.
  See docs/12_SECURITY.md section 4 (ADR-021).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
