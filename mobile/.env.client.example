# TINDAK — Flutter client build configuration
#
# Copy to .env.client (git-ignored) and fill in, then:
#   flutter run --dart-define-from-file=.env.client
#
# ONLY public, RLS-scoped client values belong here. Every key in this file is
# compiled into the app. Never add a service-role key, secret key, database
# password or access token.

SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<publishable key, sb_publishable_...>
