# TINDAK — Supabase administration credentials (server side, CEO-held)
#
# Copy to supabase/.env (git-ignored) and fill in ON THIS MACHINE ONLY.
# Never paste these values into chat, an issue, a commit or any file under
# mobile/. Never put them in the Flutter app.
#
# Database connection — project-scoped. Prefer the "Session pooler" string from
# Dashboard -> Connect, which works on IPv4 networks. Percent-encode special
# characters in the password (for example @ becomes %40).
SUPABASE_DB_URL=

# Optional. Account-wide personal access token for the Management API. Leave
# empty unless a task cannot be done through the database connection.
SUPABASE_ACCESS_TOKEN=

# Google Web Risk. DEFERRED by PD-047 and deliberately left unset: Web Risk
# requires a billing-enabled Google Cloud project. While it is empty the
# url-check function answers "unavailable" and spends none of the user's daily
# quota, which is the intended state. Setting it here is not enough — push it
# to the function with `supabase secrets set WEB_RISK_API_KEY=...`, and never
# put it in the Flutter app.
WEB_RISK_API_KEY=
